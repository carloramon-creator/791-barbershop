{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm run build"
    },
    "deploy": {
        "startCommand": "npm start",
        "restartPolicyType": "ON_FAILURE",
        "envVars": {
            "NODE_ENV": "production",
            "NIXPACKS_NODE_VERSION": "20"
        }
    }
}